# CJC-CLINIC — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# If your PHP setup doesn't auto-load .env, set these in:
#   - Apache: SetEnv in httpd.conf or .htaccess
#   - Nginx+PHP-FPM: env[] in php-fpm pool config
#   - XAMPP: SetEnv in the VirtualHost block

DB_HOST=192.168.10.96
DB_NAME=cjc_clinic
DB_USER=cjc_app          # Use a dedicated DB user, NOT root
DB_PASS=CHANGE_ME        # Set a strong password here
DB_CHARSET=utf8mb4

# Application Security
APP_ENV=production
# Generate a 64-character hex key e.g.: bin2hex(random_bytes(32))
CJC_APP_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_64_CHAR_HEX_KEY
GOOGLE_CLIENT_ID=814203352511-rp2uq7eajh56v8k9gnspbmureb2hpk3a.apps.googleusercontent.com

